---
import { slugify } from '../utils';
import FormattedDate from './FormattedDate.astro';
import type { CollectionEntry } from 'astro:content';

type BlogPost = CollectionEntry<'blog'>;
const { post }: Record<string, any> | { post: BlogPost } = Astro.props
---
<div class='mb-1 flex flex-col gap-2 border-b py-4 dark:border-b-zinc-700 sm:flex-row sm:items-start sm:gap-6'>
  <div class='w-32 shrink-0 pt-0.5 text-[0.95rem] font-medium leading-7 text-zinc-500 dark:text-zinc-400'>
    <FormattedDate date={post.data.pubDate} />
  </div>
  <div class='min-w-0 flex-1'>
    <h3 class='text-[1.2rem] font-semibold leading-snug'>
      <a class='rounded-md no-underline transition-colors duration-200 hover:text-zinc-600 dark:hover:text-zinc-300' href={`/${post.slug}/`}>
        {post.data.title}
      </a>
    </h3>
    {
      post.data.tags && post.data.tags.length > 0 && (
        <div class='mt-2.5 flex flex-wrap gap-1.5'>
          {post.data.tags.map((tag: string) => (
            <a
              class='rounded-full border border-zinc-200 px-2.5 py-0.5 text-[0.82rem] font-medium leading-normal text-zinc-600 no-underline transition-colors duration-200 hover:border-zinc-700 dark:border-zinc-800 dark:text-zinc-400 dark:hover:border-zinc-300'
              href={`/tags/${slugify(tag)}/`}
            >
              {tag}
            </a>
          ))}
        </div>
      )
    }
  </div>
</div>
