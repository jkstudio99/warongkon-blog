---
import BaseLayout from '../layouts/BaseLayout.astro';
import Prose from '../components/Prose.astro';
import { Image } from 'astro:assets';
import AvaImage from '../assets/img/ava.jpg';
import { SITE_AUTHOR } from '../consts';

const title = 'Warongkon Fukthongyoo (warongkon) — วรงค์กร ฟักทองอยู่ | Warongkon Blog';
const description =
	'ประวัติและประสบการณ์ของ Warongkon Fukthongyoo (warongkon / วรงค์กร ฟักทองอยู่) Software Developer ผู้เชี่ยวชาญด้าน C#, ASP.NET Core, TypeScript, Angular, SQL Server, System Design และ AI';

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://warongkon-blog.vercel.app').replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}/about/`;

const profilePageSchema = {
	'@type': 'ProfilePage',
	'@id': `${canonicalUrl}#profile`,
	url: canonicalUrl,
	name: title,
	description,
	inLanguage: 'th-TH',
	isPartOf: { '@id': 'https://warongkon-blog.vercel.app/#website' },
	mainEntity: { '@id': 'https://warongkon-blog.vercel.app/#person' }
};

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${siteOrigin}/`
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'About',
			item: canonicalUrl
		}
	]
};
---

<BaseLayout title={title} description={description} type='profile' schema={[profilePageSchema, breadcrumbSchema]}>
	<div class='container'>
		<div>
			<nav aria-label='Breadcrumb' class='mb-6 text-sm text-zinc-500 dark:text-zinc-400'>
				<ol class='flex flex-wrap items-center gap-2'>
					<li>
						<a href='/' class='hover:text-zinc-900 dark:hover:text-zinc-100'>Home</a>
					</li>
					<li aria-hidden='true'>/</li>
					<li class='font-medium text-zinc-800 dark:text-zinc-200' aria-current='page'>About</li>
				</ol>
			</nav>

			<article>
				<!-- Hero Section -->
				<div class='mb-16 flex flex-col items-start gap-8 md:flex-row md:items-center'>
					<Image
						src={AvaImage}
						alt='Warongkon Fukthongyoo (วรงค์กร ฟักทองอยู่) — Software Developer'
						width={160}
						height={160}
						loading='eager'
						class='h-36 w-36 shrink-0 rounded-3xl border border-zinc-200 object-cover shadow-lg dark:border-zinc-700 sm:h-40 sm:w-40'
					/>
					<div>
						<h1 class='mb-4 text-4xl font-semibold tracking-tighter sm:text-5xl'>
							About Me — Warongkon Fukthongyoo (warongkon)
						</h1>
						<p class='max-w-4xl text-xl leading-relaxed text-zinc-700 dark:text-zinc-300 sm:text-2xl'>
							Hi, I’m <strong>Warongkon Fukthongyoo (warongkon / วรงค์กร ฟักทองอยู่)</strong> – a passionate{' '}
							<strong>Software Developer</strong> with over 4 years of experience dedicated to building efficient,
							scalable, and high-performance software solutions.
						</p>
						<div class='mt-5 flex flex-wrap gap-3 text-sm font-semibold'>
							<a
								href={SITE_AUTHOR.github}
								target='_blank'
								rel='noopener noreferrer'
								class='rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-800 no-underline hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-300'
							>
								GitHub (@jkstudio99)
							</a>
							<a
								href={SITE_AUTHOR.linkedin}
								target='_blank'
								rel='noopener noreferrer'
								class='rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-800 no-underline hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-300'
							>
								LinkedIn (Warongkon Fukthongyoo)
							</a>
							<a
								href={`mailto:${SITE_AUTHOR.email}`}
								class='rounded-full border border-zinc-300 px-4 py-1.5 text-zinc-800 no-underline hover:border-zinc-700 dark:border-zinc-700 dark:text-zinc-200 dark:hover:border-zinc-300'
							>
								{SITE_AUTHOR.email}
							</a>
						</div>
					</div>
				</div>

				<Prose>
					<div class='grid gap-12 md:grid-cols-2'>
						<div>
							<h2 class='!mt-0'>Professional Journey</h2>
							<p>
								My journey into professional software development began in 2022. Over the past{' '}
								<strong>4 years</strong>, I have honed my skills by developing enterprise-grade web applications,
								RESTful APIs, and distributed architectures.
							</p>
							<p>
								ผมเชี่ยวชาญในการออกแบบและพัฒนาระบบด้วย <strong>C#, ASP.NET Core, TypeScript และ Angular</strong>{' '}
								โดยยึดหลัก <strong>Clean Architecture, Clean Code และ SOLID Principles</strong>{' '}
								เพื่อให้ซอฟต์แวร์มีความเสถียร ดูแลรักษาง่าย และรองรับการขยายตัวในระดับองค์กร
							</p>
						</div>

						<div>
							<h2 class='!mt-0'>Skills &amp; Expertise</h2>
							<ul class='space-y-2 !pl-0 list-none'>
								<li class='flex items-start gap-3'>
									<span class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-900 dark:bg-zinc-100'></span>
									<span><strong>Backend:</strong> C#, ASP.NET Core, .NET, RESTful APIs, Unit Testing</span>
								</li>
								<li class='flex items-start gap-3'>
									<span class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-900 dark:bg-zinc-100'></span>
									<span><strong>Frontend:</strong> Angular, TypeScript, Astro, Tailwind CSS, Responsive UI</span>
								</li>
								<li class='flex items-start gap-3'>
									<span class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-900 dark:bg-zinc-100'></span>
									<span><strong>Data:</strong> SQL Server, MongoDB, Database Indexing &amp; Query Optimization</span>
								</li>
								<li class='flex items-start gap-3'>
									<span class='mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-zinc-900 dark:bg-zinc-100'></span>
									<span>
										<strong>Architecture &amp; AI:</strong> SOLID, Clean Code, System Design, Microservices, AI
										Engineering
									</span>
								</li>
							</ul>
						</div>
					</div>

					<hr class='my-16 border-zinc-200 dark:border-zinc-800' />

					<div class='w-full'>
						<h2>Vision for 2026</h2>
						<p>
							This year, I am focused on deepening my expertise in <strong>System Design</strong> and integrating{' '}
							<strong>AI-driven workflows &amp; LLM orchestration</strong> to enhance the modern software engineering
							lifecycle. I believe that resilient software requires a blend of clean architecture and intelligent
							automation.
						</p>
						<p>
							I firmly believe that &ldquo;learning is a lifelong journey.&rdquo; Warongkon Blog serves as my knowledge
							hub where I document software engineering patterns, global AI breakthroughs, and Thailand/SEA tech
							insights. Explore my <a href='/posts/'>latest articles</a> or check out my{' '}
							<a href='/projects/'>projects portfolio</a>!
						</p>
					</div>
				</Prose>
			</article>
		</div>
	</div>
</BaseLayout>
