---
import { type CollectionEntry, getCollection } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import Prose from '../components/Prose.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import AboutTheAuthor from '../components/widgets/AboutTheAuthor.astro';
import TableOfContent from '../components/widgets/TableOfContent.astro';
import { slugify } from '../utils';
import { SITE_TITLE, SITE_AUTHOR } from '../consts';
import { loadEnv } from 'vite';

const { GISCUS_REPO, GISCUS_REPO_ID, GISCUS_CATEGORY, GISCUS_CATEGORY_ID } = loadEnv(
	process.env.NODE_ENV || 'production',
	process.cwd(),
	''
);

type BlogPost = CollectionEntry<'blog'>;

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).sort(
		(a: BlogPost, b: BlogPost) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	return posts.map((post: BlogPost, index: number) => {
		const prevPost = index < posts.length - 1 ? posts[index + 1] : null;
		const nextPost = index > 0 ? posts[index - 1] : null;

		const currentTags = new Set((post.data.tags || []).map((t: string) => slugify(t)));
		const scoredRelated = posts
			.filter((candidate: BlogPost) => candidate.slug !== post.slug)
			.map((candidate: BlogPost) => {
				let sharedCount = 0;
				for (const t of candidate.data.tags || []) {
					if (currentTags.has(slugify(t))) {
						sharedCount += 1;
					}
				}
				return { candidate, sharedCount };
			})
			.sort((a, b) => {
				if (b.sharedCount !== a.sharedCount) {
					return b.sharedCount - a.sharedCount;
				}
				return b.candidate.data.pubDate.valueOf() - a.candidate.data.pubDate.valueOf();
			})
			.slice(0, 4)
			.map((item) => item.candidate);

		return {
			params: { slug: post.slug },
			props: {
				post,
				prevPost,
				nextPost,
				relatedPosts: scoredRelated
			}
		};
	});
}

interface Props {
	post: BlogPost;
	prevPost: BlogPost | null;
	nextPost: BlogPost | null;
	relatedPosts: BlogPost[];
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const {
	data: { title, seoTitle, description, coverImage, pubDate, updatedDate, tags }
} = post;
const { Content, headings } = await post.render();

let ogImageUrl = '/og-default.png';
if (coverImage && coverImage.format !== 'svg') {
	try {
		const optimizedOg = await getImage({
			src: coverImage,
			width: 1200,
			format: 'jpg',
			quality: 82
		});
		ogImageUrl = optimizedOg.src;
	} catch {
		ogImageUrl = '/og-default.png';
	}
}

const baseSeoTitle = seoTitle || title;
const effectiveTitle = /warongkon/i.test(baseSeoTitle)
	? baseSeoTitle
	: `${baseSeoTitle} | ${SITE_TITLE}`;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://warongkon-blog.vercel.app').replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}/${post.slug}/`;
const rawBody = post.body || '';
const wordCount = Math.max(1, rawBody.trim().split(/\s+/).filter(Boolean).length);
const readingTimeMinutes = Math.max(1, Math.ceil(rawBody.length / 900));
const hasDistinctUpdatedDate = Boolean(updatedDate && updatedDate.valueOf() !== pubDate.valueOf());
const hasHeadings = Array.isArray(headings) && headings.some((h: any) => h.depth === 2 || h.depth === 3);

const blogPostingSchema = {
	'@type': 'BlogPosting',
	'@id': `${canonicalUrl}#article`,
	mainEntityOfPage: {
		'@type': 'WebPage',
		'@id': canonicalUrl
	},
	headline: title,
	alternativeHeadline: baseSeoTitle,
	description,
	image: [new URL(ogImageUrl, siteOrigin).toString()],
	datePublished: pubDate.toISOString(),
	dateModified: (updatedDate || pubDate).toISOString(),
	author: {
		'@id': 'https://warongkon-blog.vercel.app/#person'
	},
	publisher: {
		'@id': 'https://warongkon-blog.vercel.app/#person'
	},
	url: canonicalUrl,
	keywords: (tags || []).join(', '),
	articleSection: tags?.[0] || 'Technology',
	wordCount,
	inLanguage: 'th-TH'
};

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${siteOrigin}/`
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Posts',
			item: `${siteOrigin}/posts/`
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: title,
			item: canonicalUrl
		}
	]
};
---

<BaseLayout
	title={effectiveTitle}
	description={description}
	image={ogImageUrl}
	imageAlt={title}
	type='article'
	pubDate={pubDate}
	updatedDate={updatedDate || pubDate}
	tags={tags}
	schema={[blogPostingSchema, breadcrumbSchema]}
>
	<div class='container gap-10 lg:flex'>
		<div class='min-w-0 grow overflow-hidden'>
			<article>
				<nav aria-label='Breadcrumb' class='mb-6 text-sm text-zinc-500 dark:text-zinc-400'>
					<ol class='flex flex-wrap items-center gap-2'>
						<li>
							<a href='/' class='hover:text-zinc-900 dark:hover:text-zinc-100'>Home</a>
						</li>
						<li aria-hidden='true'>/</li>
						<li>
							<a href='/posts/' class='hover:text-zinc-900 dark:hover:text-zinc-100'>Posts</a>
						</li>
						<li aria-hidden='true'>/</li>
						<li class='truncate max-w-[280px] sm:max-w-[480px] font-medium text-zinc-800 dark:text-zinc-200' aria-current='page'>
							{title}
						</li>
					</ol>
				</nav>

				<Prose>
					<header class='mb-10'>
						<h1 class='!mb-6 !leading-[1.2]'>{title}</h1>
						<div class='flex flex-wrap items-center gap-x-6 gap-y-3 text-sm font-medium text-zinc-600 dark:text-zinc-300'>
							<div class='flex items-center gap-2'>
								<span>โดย</span>
								<a
									href='/about/'
									class='font-semibold text-zinc-900 underline decoration-zinc-400 underline-offset-4 hover:decoration-zinc-900 dark:text-zinc-100 dark:hover:decoration-zinc-100'
								>
									{SITE_AUTHOR.name}
								</a>
							</div>
							<div class='flex items-center gap-2'>
								<svg
									xmlns='http://www.w3.org/2000/svg'
									width='18'
									height='18'
									viewBox='0 0 24 24'
									fill='none'
									stroke='currentColor'
									stroke-width='2'
									stroke-linecap='round'
									stroke-linejoin='round'
									class='lucide lucide-calendar-days'
									><path d='M8 2v4'></path><path d='M16 2v4'></path><rect width='18' height='18' x='3' y='4' rx='2'
									></rect><path d='M3 10h18'></path><path d='M8 14h.01'></path><path d='M12 14h.01'></path><path
										d='M16 14h.01'></path><path d='M8 18h.01'></path><path d='M12 18h.01'></path><path d='M16 18h.01'
									></path></svg
								>
								<span>
									เผยแพร่ <FormattedDate date={pubDate} />
								</span>
								{
									hasDistinctUpdatedDate && updatedDate && (
										<span class='text-zinc-500 dark:text-zinc-400'>
											(อัปเดต <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
							<div class='flex items-center gap-1.5 text-zinc-500 dark:text-zinc-400'>
								<span>• อ่านประมาณ {readingTimeMinutes} นาที</span>
							</div>
							<div class='flex flex-wrap gap-2'>
								{
									(tags || [])?.map((tag: string) => (
										<a
											class='rounded-full bg-zinc-100 px-3 py-1 text-xs font-semibold text-zinc-700 no-underline transition-colors hover:bg-zinc-200 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-700'
											href={`/tags/${slugify(tag)}/`}
										>
											{tag}
										</a>
									))
								}
							</div>
						</div>
					</header>

					{
						coverImage && (
							<figure class='mb-12 overflow-hidden'>
								<Image
									class='m-0 w-full rounded-[2rem] shadow-2xl shadow-black/10'
									src={coverImage}
									alt={title}
									width={960}
									widths={[480, 768, 960]}
									sizes='(max-width: 768px) 100vw, 880px'
									loading='eager'
									fetchpriority='high'
								/>
							</figure>
						)
					}

					{
						hasHeadings && (
							<details class='not-prose mb-8 rounded-2xl border border-zinc-200 bg-zinc-50/80 p-4 dark:border-zinc-800 dark:bg-zinc-800/40 md:hidden'>
								<summary class='cursor-pointer text-base font-bold text-zinc-900 dark:text-zinc-100'>
									สารบัญบทความ (Table of Contents)
								</summary>
								<ul class='mt-3 space-y-2 text-sm text-zinc-700 dark:text-zinc-300'>
									{headings
										.filter((h: any) => h.depth === 2 || h.depth === 3)
										.map((h: any) => (
											<li class={h.depth === 3 ? 'pl-4' : ''}>
												<a href={`#${h.slug}`} class='hover:underline'>
													{h.text}
												</a>
											</li>
										))}
								</ul>
							</details>
						)
					}

					<Content />
				</Prose>

				<div class='mt-10 md:hidden'>
					<AboutTheAuthor />
				</div>

				{
					(prevPost || nextPost) && (
						<nav
							aria-label='Adjacent articles'
							class='mt-12 grid gap-4 border-t border-zinc-200 pt-8 dark:border-zinc-800 sm:grid-cols-2'
						>
							{prevPost ? (
								<a
									href={`/${prevPost.slug}/`}
									class='group rounded-2xl border border-zinc-200 p-4 no-underline transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600'
								>
									<span class='block text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400'>
										&larr; บทความก่อนหน้า (Previous)
									</span>
									<span class='mt-1 block text-base font-bold text-zinc-900 group-hover:underline dark:text-zinc-100'>
										{prevPost.data.title}
									</span>
								</a>
							) : (
								<div />
							)}
							{nextPost && (
								<a
									href={`/${nextPost.slug}/`}
									class='group rounded-2xl border border-zinc-200 p-4 text-right no-underline transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600'
								>
									<span class='block text-xs font-semibold uppercase tracking-wide text-zinc-500 dark:text-zinc-400'>
										บทความถัดไป (Next) &rarr;
									</span>
									<span class='mt-1 block text-base font-bold text-zinc-900 group-hover:underline dark:text-zinc-100'>
										{nextPost.data.title}
									</span>
								</a>
							)}
						</nav>
					)
				}

				{
					relatedPosts && relatedPosts.length > 0 && (
						<section
							aria-label='Related posts'
							class='mt-12 border-t border-zinc-200 pt-8 dark:border-zinc-800'
						>
							<h2 class='mb-6 text-2xl font-bold text-zinc-900 dark:text-zinc-100'>
								บทความที่เกี่ยวข้อง (Related Posts)
							</h2>
							<div class='grid gap-4 sm:grid-cols-2'>
								{relatedPosts.map((rel: BlogPost) => (
									<article class='rounded-2xl border border-zinc-200 p-5 transition-colors hover:border-zinc-400 dark:border-zinc-800 dark:hover:border-zinc-600'>
										<div class='mb-2 text-xs font-medium text-zinc-500 dark:text-zinc-400'>
											<FormattedDate date={rel.data.pubDate} />
										</div>
										<h3 class='mb-2 text-lg font-bold leading-snug'>
											<a
												href={`/${rel.slug}/`}
												class='text-zinc-900 no-underline hover:underline dark:text-zinc-100'
											>
												{rel.data.title}
											</a>
										</h3>
										<p class='line-clamp-2 text-sm text-zinc-600 dark:text-zinc-400'>
											{rel.data.description}
										</p>
									</article>
								))}
							</div>
						</section>
					)
				}

				{
					GISCUS_REPO && (
						<script
							id='giscus-script'
							is:inline
							src='https://giscus.app/client.js'
							data-repo={GISCUS_REPO}
							data-repo-id={GISCUS_REPO_ID}
							data-category={GISCUS_CATEGORY}
							data-category-id={GISCUS_CATEGORY_ID}
							data-mapping='pathname'
							data-strict='0'
							data-reactions-enabled='1'
							data-emit-metadata='0'
							data-input-position='bottom'
							data-theme='preferred_color_scheme'
							data-lang='en'
							crossorigin='anonymous'
							async
						/>
					)
				}
			</article>
		</div>
		<aside class='hidden w-[300px] shrink-0 md:block' aria-label='Article sidebar'>
			<div class='mb-4'>
				<AboutTheAuthor />
			</div>
			{hasHeadings && <TableOfContent headings={headings} />}
		</aside>
	</div>
</BaseLayout>

<script async is:inline>
	const anchors = document.querySelectorAll('.prose h2[id], .prose h3[id]');
	const links = document.querySelectorAll('nav.toc ul li a');

	function observeToc() {
		if (typeof anchors != 'undefined' && anchors != null && typeof links != 'undefined' && links != null) {
			let scrollTop = window.scrollY;

			// highlight the last scrolled-to: set everything inactive first
			for (const link of links) {
				link.classList.add('border-transparent', 'text-inherit');
				link.classList.remove(
					'bg-[var(--background-surface-color)]',
					'border-[var(--soft-border-color)]',
					'text-[var(--link-color)]'
				);
			}
			// then iterate backwards, on the first match highlight it and break
			for (var i = anchors.length - 1; i >= 0; i--) {
				if (scrollTop > anchors[i].offsetTop - 80) {
					if (links[i]) {
						links[i].classList.remove('border-transparent', 'text-inherit');
						links[i].classList.add(
							'bg-[var(--background-surface-color)]',
							'border-[var(--soft-border-color)]',
							'text-[var(--link-color)]'
						);
					}
					break;
				}
			}
		}
	}

	window.addEventListener('scroll', (event) => {
		observeToc(event);
	});
	window.addEventListener('hashchange', (event) => {
		observeToc(event);
	});
</script>
