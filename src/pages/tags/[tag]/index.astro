---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseLayout from '@src/layouts/BaseLayout.astro';
import { slugify, unslugify } from '@src/utils';
import PostsByYear from '@src/components/PostsByYear.astro';

type BlogPost = CollectionEntry<'blog'>;

export const getStaticPaths = async () => {
	const allPosts: BlogPost[] = (await getCollection('blog')).sort(
		(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
	);

	const tagMap = new Map<string, { labelCounts: Map<string, number>; posts: BlogPost[] }>();

	for (const post of allPosts) {
		const seenSlugsInPost = new Set<string>();
		for (const rawTag of post.data.tags || []) {
			if (!rawTag) continue;
			const tagSlug = slugify(rawTag);
			if (!tagSlug) continue;

			let entry = tagMap.get(tagSlug);
			if (!entry) {
				entry = { labelCounts: new Map(), posts: [] };
				tagMap.set(tagSlug, entry);
			}

			entry.labelCounts.set(rawTag, (entry.labelCounts.get(rawTag) || 0) + 1);
			if (!seenSlugsInPost.has(tagSlug)) {
				seenSlugsInPost.add(tagSlug);
				entry.posts.push(post);
			}
		}
	}

	return [...tagMap.entries()].map(([tagSlug, data]) => {
		let bestLabel = unslugify(tagSlug);
		let bestCount = -1;
		for (const [label, count] of data.labelCounts.entries()) {
			if (
				count > bestCount ||
				(count === bestCount && label === label.toUpperCase() && label !== label.toLowerCase())
			) {
				bestLabel = label;
				bestCount = count;
			}
		}

		return {
			params: { tag: tagSlug },
			props: {
				tagLabel: bestLabel,
				taggedPosts: data.posts
			}
		};
	});
};

interface Props {
	tagLabel: string;
	taggedPosts: BlogPost[];
}

const { tag } = Astro.params;
const { tagLabel = unslugify(tag || ''), taggedPosts = [] } = Astro.props;

const title = `รวมบทความเกี่ยวกับ ${tagLabel} (${taggedPosts.length} บทความ) | Warongkon Blog`;
const description = `สำรวจบทความ ข่าวสาร และเทคนิคเชิงลึกเกี่ยวกับ ${tagLabel} จำนวน ${taggedPosts.length} บทความ บน Warongkon Blog โดย วรงค์กรณ์ ฟักทองอยู่ (Warongkon Fukthongyoo)`;
const isThinTag = taggedPosts.length < 2;

const siteOrigin = (Astro.site ? Astro.site.toString() : 'https://warongkon-blog.vercel.app').replace(/\/+$/, '');
const canonicalUrl = `${siteOrigin}/tags/${tag}/`;

const collectionSchema = {
	'@type': 'CollectionPage',
	'@id': `${canonicalUrl}#collection`,
	url: canonicalUrl,
	name: title,
	description,
	isPartOf: { '@id': 'https://warongkon-blog.vercel.app/#website' },
	inLanguage: 'th-TH',
	mainEntity: {
		'@type': 'ItemList',
		itemListElement: taggedPosts.slice(0, 20).map((post, idx) => ({
			'@type': 'ListItem',
			position: idx + 1,
			url: `${siteOrigin}/${post.slug}/`,
			name: post.data.title
		}))
	}
};

const breadcrumbSchema = {
	'@type': 'BreadcrumbList',
	'@id': `${canonicalUrl}#breadcrumb`,
	itemListElement: [
		{
			'@type': 'ListItem',
			position: 1,
			name: 'Home',
			item: `${siteOrigin}/`
		},
		{
			'@type': 'ListItem',
			position: 2,
			name: 'Tags',
			item: `${siteOrigin}/tags/`
		},
		{
			'@type': 'ListItem',
			position: 3,
			name: tagLabel,
			item: canonicalUrl
		}
	]
};
---

<BaseLayout title={title} description={description} noindex={isThinTag} schema={[collectionSchema, breadcrumbSchema]}>
	<div class='container'>
		<nav aria-label='Breadcrumb' class='mb-6 text-sm text-zinc-500 dark:text-zinc-400'>
			<ol class='flex flex-wrap items-center gap-2'>
				<li>
					<a href='/' class='hover:text-zinc-900 dark:hover:text-zinc-100'>Home</a>
				</li>
				<li aria-hidden='true'>/</li>
				<li>
					<a href='/tags/' class='hover:text-zinc-900 dark:hover:text-zinc-100'>Tags</a>
				</li>
				<li aria-hidden='true'>/</li>
				<li class='font-medium text-zinc-800 dark:text-zinc-200' aria-current='page'>
					{tagLabel}
				</li>
			</ol>
		</nav>
		<div class='mb-10'>
			<h1 class='mb-3 text-4xl font-bold leading-tight'>
				รวมบทความเกี่ยวกับ {tagLabel} ({taggedPosts.length} บทความ)
			</h1>
			<p class='text-[1.12rem] leading-8 text-zinc-700 dark:text-zinc-300'>
				{description}
			</p>
		</div>
		<PostsByYear posts={taggedPosts} />
	</div>
</BaseLayout>
